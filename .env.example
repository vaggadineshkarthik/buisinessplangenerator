# ---------------------------------------------------------------------------
# RAGify AI — environment configuration
# Copy this file to `.env` in the project root and fill in your values.
# The backend reads this file automatically; the API key is never exposed
# to the frontend.
# ---------------------------------------------------------------------------

# --- OpenRouter (LLM generation) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=RAGify AI
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1200

# --- Embeddings (local, no API key required) ---
# Alternative: all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# --- Vector database ---
VECTOR_DB=chroma
CHROMA_COLLECTION=ragify_documents

# --- Chunking & retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.35
MAX_RETRIES=2

# --- Uploads ---
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.csv

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (public) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
